---
import { dataLonga, mk, ok, t } from '../lib/dados';
import { foto } from '../lib/fotos';
import Container from './Container.astro';
import Foto from './Foto.astro';
import Titulo from './Titulo.astro';

type TipoMidia = keyof typeof t.midia.tipos;
type Registro = {
  tipo: string;
  veiculo: string;
  titulo?: string;
  data?: string;
  descricao?: string;
  autor?: string;
  url?: string;
  exibir?: boolean;
  destaque?: boolean;
  imagem?: { arquivo: string; alt: string };
  // "citaApoio", "print" e "urlEncontrada" são anotações de controle e não aparecem no site.
};

// "exibir": false guarda o registro no JSON sem mostrar (ex.: publicação ainda não confirmada).
const registros = (mk.naMidia as Registro[])
  .filter((r) => ok(r.veiculo) && r.exibir !== false)
  .map((r) => ({ ...r, img: foto(r.imagem?.arquivo) }));
type Item = (typeof registros)[number];

const tipos = Object.keys(t.midia.tipos) as TipoMidia[];
const tipoDe = (r: Registro): TipoMidia => (tipos.includes(r.tipo as TipoMidia) ? (r.tipo as TipoMidia) : 'materia');
const textoTipo = (r: Registro) => t.midia.tipos[tipoDe(r)];

const linhaData = (r: Registro) =>
  [ok(r.data) ? dataLonga(r.data) : '', ok(r.autor) ? `${t.midia.por} ${r.autor}` : ''].filter(Boolean).join(' · ');
const altImagem = (r: Item) => (ok(r.imagem?.alt) ? r.imagem!.alt : `${textoTipo(r).titulo}: ${r.veiculo}`);
const link = (r: Registro) => (ok(r.url) ? { href: r.url, target: '_blank', rel: 'noopener noreferrer' } : null);

// "destaque": true abre a seção num cartão largo; o resto é agrupado por tipo.
const destaques = registros.filter((r) => r.destaque);
const demais = registros.filter((r) => !r.destaque);

// Um grupo por tipo, na ordem de textos.midia.tipos. Dentro do grupo, primeiro os registros com imagem,
// depois os só de texto, para que cartões sem imagem não fiquem esticados ao lado de cartões com imagem.
const grupos = tipos
  .map((tipo) => {
    const itens = demais.filter((r) => tipoDe(r) === tipo);
    return {
      tipo,
      ...t.midia.tipos[tipo],
      total: itens.length,
      blocos: [itens.filter((r) => r.img), itens.filter((r) => !r.img)].filter((b) => b.length > 0),
    };
  })
  .filter((g) => g.total > 0);

const mostrarTitulosGrupo = grupos.length > 1 || destaques.length > 0;
const rotuloVeiculo = 'font-condensed text-[17px] font-bold tracking-[0.12em] text-link uppercase';
---
{registros.length > 0 && (
  <section id="midia" aria-labelledby="midia-titulo" class="bg-white">
    <Container class="flex flex-col gap-12 py-16 sm:py-20">
      <div class="flex max-w-[680px] flex-col gap-3">
        <Titulo id="midia-titulo">{t.midia.titulo}</Titulo>
        {ok(t.midia.intro) && <p class="m-0 text-[19px] text-muted">{t.midia.intro}</p>}
      </div>

      {destaques.map((r) => {
        const attrs = link(r);
        return (
          <article class="flex flex-col overflow-hidden rounded-lg border border-line bg-paper lg:flex-row">
            {r.img && (
              <div class="relative aspect-[4/5] lg:aspect-auto lg:min-h-[480px] lg:basis-[400px] lg:shrink-0">
                <Foto
                  src={r.img}
                  alt={altImagem(r)}
                  widths={[400, 720, 1080]}
                  sizes="(min-width: 1024px) 400px, 100vw"
                  class="absolute inset-0 h-full w-full object-cover object-top"
                />
              </div>
            )}
            <div class="flex grow flex-col justify-center gap-4 p-7 sm:p-10">
              <span class={rotuloVeiculo}>
                {t.midia.destaque} · {textoTipo(r).titulo}
              </span>
              <h3 class="m-0 font-condensed text-[40px] leading-none font-extrabold text-navy uppercase sm:text-[52px]">
                {r.veiculo}
              </h3>
              {ok(r.titulo) && <p class="m-0 text-[22px] leading-[1.3] font-semibold">{r.titulo}</p>}
              {ok(r.descricao) && <p class="m-0 max-w-[620px] text-[19px] text-muted">{r.descricao}</p>}
              {linhaData(r) && <p class="m-0 text-[15px] text-muted">{linhaData(r)}</p>}
              {attrs && (
                <a
                  {...attrs}
                  class="mt-2 self-start rounded-md bg-navy px-7 py-3.5 text-[18px] font-semibold text-white no-underline transition-colors hover:bg-deep hover:text-white"
                >
                  {textoTipo(r).acao}
                </a>
              )}
            </div>
          </article>
        );
      })}

      {grupos.map((grupo) => (
        <div class="flex flex-col gap-5">
          {mostrarTitulosGrupo && (
            <h3 class="m-0 border-b border-line pb-3 text-[20px] font-semibold text-navy">{grupo.titulo}</h3>
          )}
          {grupo.blocos.map((bloco) => (
            <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
              {bloco.map((r) => {
                const attrs = link(r);
                const Tag = attrs ? 'a' : 'div';
                return (
                  <li>
                    <Tag
                      {...(attrs ?? {})}
                      class:list={[
                        'flex h-full flex-col overflow-hidden rounded-lg border border-line bg-white text-ink no-underline',
                        attrs && 'transition-colors hover:border-link',
                      ]}
                    >
                      {r.img && (
                        <Foto
                          src={r.img}
                          alt={altImagem(r)}
                          widths={[360, 640, 960]}
                          sizes="(min-width: 1024px) 340px, (min-width: 640px) 50vw, 100vw"
                          class="aspect-[4/5] w-full border-b border-line bg-paper object-cover object-top"
                        />
                      )}
                      <div class="flex grow flex-col gap-2.5 p-6 sm:p-7">
                        <span class={rotuloVeiculo}>{r.veiculo}</span>
                        {ok(r.titulo) && <span class="text-[20px] leading-[1.3] font-semibold">{r.titulo}</span>}
                        {ok(r.descricao) && <span class="text-muted">{r.descricao}</span>}
                        {linhaData(r) && <span class="text-[15px] text-muted">{linhaData(r)}</span>}
                        {attrs && <span class="mt-auto pt-1 font-semibold text-link">{grupo.acao}</span>}
                      </div>
                    </Tag>
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      ))}
    </Container>
  </section>
)}
