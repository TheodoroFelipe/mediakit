---
// Foto otimizada: AVIF/WebP com fallback JPG, sem nunca servir o original.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  prioridade?: boolean;
}

const { src, alt, widths, sizes, class: classe, prioridade = false } = Astro.props;
const larguras = widths.filter((w) => w <= src.width);
const larguraBase = Math.max(...(larguras.length ? larguras : [src.width]));
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  width={larguraBase}
  widths={larguras.length ? larguras : undefined}
  sizes={sizes}
  quality={78}
  loading={prioridade ? 'eager' : 'lazy'}
  fetchpriority={prioridade ? 'high' : undefined}
  class={classe}
/>
